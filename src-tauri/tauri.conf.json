{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JarBox",
  "version": "1.0.0",
  "identifier": "com.jarbox.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JarBox · JAR 服务管理器",
        "width": 1240,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true,
        "theme": "Light",
        "backgroundColor": "#f5f6f9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "JarBox",
    "shortDescription": "本地 JAR 服务管理器",
    "longDescription": "JarBox 是一个基于 Tauri 的本地 JAR 服务管理器，支持多 JDK、服务启停、日志筛选与 JAR 内配置查看。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
